<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- OS SplashScreen 은 Android 12+에서 강제 노출되므로 투명 아이콘 + 흰 배경으로 "보이지 않게" 처리.
         실제 사용자에게 보이는 splash 는 MainActivity 의 Compose SplashView (iOS 디자인 그대로 이식).
         결과: 시각적으로 splash 는 Compose 1개만 인식됨 (OS splash 는 흰 화면으로 잠시 뜨고 교체). -->
    <style name="Theme.FearIndex.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_invisible</item>
        <item name="postSplashScreenTheme">@style/Theme.FearIndex</item>
    </style>

    <!-- Android 15 (targetSdk 35) edge-to-edge: enableEdgeToEdge() 가 Activity 단에서
         system bar 를 transparent + 인셋을 Compose 에 직접 전달한다.
         system bar color item 은 Android 15 edge-to-edge 모드에서 deprecated/무시됨. → 제거. -->
    <style name="Theme.FearIndex" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
