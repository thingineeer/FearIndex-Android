    <string name="onboarding_step1_title">Kielezo hiki kinafuata S&amp;P 500</string>
    <string name="onboarding_step1_detail">Kinaonyesha hofu na tamaa ya soko la Marekani kwa nambari moja kutoka 0 hadi 100. Chini zaidi ni hofu, juu zaidi ni tamaa.</string>
    <string name="onboarding_step2_title">Kielezo hiki kinafuata KOSPI</string>
    <string name="onboarding_step2_detail">Ona hisia za soko la Korea kwa njia ile ile. Badilisha wakati wowote kwa sehemu zilizo juu.</string>
    <string name="onboarding_step3_title">Kielezo hiki kinafuata BTC</string>
    <string name="onboarding_step3_detail">Hofu na tamaa ya soko la sarafu za kidijitali pia ziko kwenye kipimo kile kile.</string>
    <string name="onboarding_step4_title">Je, ingekuwaje kama ungenunua kwa alama hii?</string>
    <string name="onboarding_step4_detail">Wastani wa faida ya kihistoria unaponunua katika kiwango cha sasa. Haihakikishwi — itumie kwa tahadhari.</string>
    <string name="onboarding_step5_title">Piga kura kuhusu hali yako sasa</string>
    <string name="onboarding_step5_detail">Acha hali yako kwa mguso mmoja na ufuatilie hisia za wawekezaji duniani kote papo hapo.</string>
    <string name="onboarding_step6_title">Tutakujulisha wakati unaofaa</string>
    <string name="onboarding_step6_detail">Weka arifa na tutakujulisha mara kielezo kitakapofikia kiwango chako.</string>
    <string name="onboarding_step7_title">Haraka zaidi kwa wijeti</string>
    <string name="onboarding_step7_detail">Mwongozo wa wijeti unapatikana kwenye skrini hii wakati wowote.</string>
    <string name="onboarding_step8_title">Kanuni binafsi ya msanidi</string>
    <string name="onboarding_step8_detail">Msanidi hununua tu kwa 15 au chini. Zaidi ya hapo huenda ikahitaji subira ndefu. Ni kanuni binafsi, si ushauri wa uwekezaji.</string>

