    <string name="kospi_method_score_collections">The current score and five-year history are stored separately so today\'s sentiment can be compared with later KOSPI outcomes.</string>
    <string name="kospi_method_quality_header">Data quality</string>
    <string name="kospi_method_carry_forward">If one data point is missing, the previous value is carried forward for up to three trading days; older values are dropped.</string>
